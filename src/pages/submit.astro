---
import BaseLayout from "@layouts/BaseLayout.astro";
import config from "@util/themeConfig";

const receiverEmail = "submit@aipick.de5.net";
---

<BaseLayout title="Submit Your AI Tool - AI Tools Hub">
  <main class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">Submit Your AI Tool</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Get your AI tool listed in front of thousands of users searching for the right tool. 
      Fill out the form below, click submit, and your email client will open with all the details pre-filled.
    </p>

    <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-8">
      <p class="text-sm text-blue-800 dark:text-blue-200">
        <strong>Free listing:</strong> Basic listing with name, description, and link.<br>
        <strong>Featured listing ($49):</strong> Priority placement, highlighted badge, and top-of-category position.
      </p>
    </div>

    <form id="submit-form" class="space-y-6">
      <div>
        <label for="tool_name" class="block text-sm font-medium mb-1">Tool Name *</label>
        <input
          type="text"
          id="tool_name"
          required
          placeholder="e.g. ChatGPT, Midjourney"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="tool_url" class="block text-sm font-medium mb-1">Tool URL *</label>
        <input
          type="url"
          id="tool_url"
          required
          placeholder="https://your-tool.com"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
      </div>

      <div>
        <label for="description" class="block text-sm font-medium mb-1">Short Description *</label>
        <textarea
          id="description"
          required
          rows="3"
          placeholder="Describe what your tool does in 1-2 sentences"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        ></textarea>
      </div>

      <div>
        <label for="category" class="block text-sm font-medium mb-1">Category *</label>
        <select
          id="category"
          required
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        >
          <option value="">Select a category</option>
          <option value="Writing">Writing</option>
          <option value="Coding">Coding</option>
          <option value="Image Generation">Image Generation</option>
          <option value="Video">Video</option>
          <option value="Chatbot">Chatbot</option>
          <option value="Productivity">Productivity</option>
          <option value="Marketing">Marketing</option>
          <option value="Audio">Audio</option>
          <option value="Design">Design</option>
          <option value="Research">Research</option>
        </select>
      </div>

      <div>
        <label for="pricing" class="block text-sm font-medium mb-1">Pricing Model</label>
        <select
          id="pricing"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        >
          <option value="Free">Free</option>
          <option value="Freemium">Freemium</option>
          <option value="Paid">Paid</option>
          <option value="Open Source">Open Source</option>
        </select>
      </div>

      <div>
        <label for="submitter_email" class="block text-sm font-medium mb-1">Your Email *</label>
        <input
          type="email"
          id="submitter_email"
          required
          placeholder="you@example.com"
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
        <p class="text-xs text-gray-500 mt-1">So we can notify you when listed.</p>
      </div>

      <div>
        <label class="block text-sm font-medium mb-2">Listing Type</label>
        <div class="space-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="listing_type" value="Free Basic Listing" checked class="text-blue-600" />
            <span>Free Basic Listing</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="listing_type" value="Featured Listing ($49)" class="text-blue-600" />
            <span>Featured Listing ($49) — Priority placement + badge</span>
          </label>
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3 px-6 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        Open Email & Submit
      </button>

      <p class="text-xs text-gray-500 text-center">
        Clicking submit will open your email client with the submission details pre-filled. 
        Just hit "Send" in your email app.
      </p>
    </form>
  </main>

  <script define:vars={{ receiverEmail }}>
    document.getElementById('submit-form').addEventListener('submit', function(e) {
      e.preventDefault();

      const toolName = document.getElementById('tool_name').value;
      const toolUrl = document.getElementById('tool_url').value;
      const description = document.getElementById('description').value;
      const category = document.getElementById('category').value;
      const pricing = document.getElementById('pricing').value;
      const submitterEmail = document.getElementById('submitter_email').value;
      const listingType = document.querySelector('input[name="listing_type"]:checked').value;

      const subject = `[AI Tools Hub] Tool Submission: ${toolName}`;

      const body = [
        `Hi AI Tools Hub Team,`,
        ``,
        `I'd like to submit my AI tool for listing on your directory.`,
        ``,
        `--- TOOL DETAILS ---`,
        ``,
        `Tool Name: ${toolName}`,
        `URL: ${toolUrl}`,
        `Category: ${category}`,
        `Pricing: ${pricing}`,
        `Listing Type: ${listingType}`,
        ``,
        `Description:`,
        `${description}`,
        ``,
        `--- CONTACT ---`,
        ``,
        `Email: ${submitterEmail}`,
        ``,
        `---`,
        `Looking forward to being listed!`,
      ].join('\n');

      const mailtoLink = `mailto:${receiverEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      
      window.location.href = mailtoLink;
    });
  </script>
</BaseLayout>
