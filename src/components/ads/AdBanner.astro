---

<div class="ad-banner w-full flex justify-center my-8">
  <div class="ad-container max-w-[728px] w-full flex flex-col items-center">
    <iframe
      src="/ad-frame.html"
      width="728"
      height="90"
      frameborder="0"
      scrolling="no"
      sandbox="allow-scripts allow-same-origin allow-popups"
      loading="lazy"
      class="mx-auto block border border-gray-200 dark:border-gray-700 rounded"
      style="max-width: 100%; height: 90px;"
    ></iframe>
    <p class="text-[10px] text-gray-400 text-center mt-1">Advertisement</p>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .ad-banner iframe {
      width: 320px;
      height: 50px;
    }
  }
</style>
